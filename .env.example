# Copy this file to .env and fill in one or both keys. Never commit the real .env.
# The app looks for .env in this folder first, then in the folder above it.

# Course key: all AI calls go through Portkey and use gpt-6-luna.
PORTKEY_API_KEY=

# An OpenAI key. Used when there is no Portkey key, or if Portkey rejects its key.
OPENAI_API_KEY=

# ---- Optional settings (the defaults work without any of these) ----
# Model to use with OPENAI_API_KEY. Ignored on Portkey, which always uses gpt-6-luna.
# OPENAI_MODEL=gpt-6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# OPENAI_REASONING_EFFORT=low

# Token prices in dollars per one million tokens, used only to show the AI cost of each run.
# PRICE_INPUT_PER_M=
# PRICE_CACHED_INPUT_PER_M=
# PRICE_OUTPUT_PER_M=

# Limits
# MAX_INPUT_CHARS=1200
# MAX_REQUESTS_PER_RUN=16
# MAX_TOOL_CALLS_PER_RUN=24
# MAX_TOKENS_PER_RUN=80000
# MAX_RUNS_PER_MINUTE=6
# MAX_TOKENS_PER_DAY=2000000

# Use a different price file (for example a fresh extract of the hospital's full file).
# PRICE_FILE=data/ynhh_ed_standard_charges.csv
